# Copy to /opt/browser-rpg/server/.env on the VPS
# systemd loads this via EnvironmentFile=

PORT=3001
# Production: only localhost (Caddy proxies public traffic)
HOST=127.0.0.1

# Required — generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Persistent SQLite (mount backups from this path)
DATABASE_PATH=/var/lib/browser-rpg/game.db

# Optional — only if static site is on another origin
# CORS_ORIGIN=https://yourgame.example.com

WORLD_ID=default
WORLD_LABEL=Main World
